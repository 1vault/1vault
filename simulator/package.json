{
  "name": "1vault-simulator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "n8n-style live Devnet workflow simulator for 1Vault",
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"npm run server\" \"vite\"",
    "server": "tsx watch server/index.ts",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@coral-xyz/anchor": "^0.31.1",
    "@solana/spl-token": "^0.4.15",
    "@solana/web3.js": "^1.98.4",
    "@xyflow/react": "^12.11.3",
    "bs58": "^6.0.0",
    "express": "^5.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^10.0.5",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.1"
  }
}
