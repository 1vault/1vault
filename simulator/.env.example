CLUSTER=devnet
TRADE_EXECUTION=demo
INDEXER_API=http://127.0.0.1:3001
PORT=8788
# Leave RPC_URL unset to inherit ProgramID/onevault-program/sdk/.env (then indexer/.env).
# Only set RPC_URL here if you need an override with a real Helius key — never YOUR_HELIUS_API_KEY.
# RPC_URL=https://devnet.helius-rpc.com/?api-key=YOUR_REAL_KEY
# Mainnet: CLUSTER=mainnet-beta TRADE_EXECUTION=live plus PROGRAM_ID / PROTOCOL_CONFIG / wallets / LICENSE_MINT
#
# No DATABASE_URL in the simulator. The indexer owns Postgres:
#   ProgramID/onevault-indexer/.env  →  DATABASE_URL
# Simulator writes the ledger through INDEXER_API. Run `npm run api` in onevault-indexer.
