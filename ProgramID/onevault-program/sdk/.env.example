# Copy to sdk/.env (never commit .env)
RPC_URL=https://devnet.helius-rpc.com/?api-key=YOUR_HELIUS_KEY

# Bootstrap deployer keypair — must match mint authority on devnet
# KEYPAIR_PATH=/path/to/deployer-keypair.json

# Wallet that receives 1VL for simulator degen flow
TARGET_WALLET=ETCBEqkrKYM6S7M7nqAJadmkDKZrTmftZLwsaoXFtpMR

# Raw amount (6 decimals). Default: 1000000000000 = 1,000,000 whole 1VL
# AMOUNT_RAW=1000000000000
