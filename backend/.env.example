PORT=3090
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/onevault
# Supabase on Railway — use TRANSACTION pooler (:6543), not session (:5432):
# DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres?sslmode=require
# If TLS verify still fails (rare): DATABASE_SSL_INSECURE=1
# DB_MAX_CONNS=4
# DB_MIN_CONNS=0
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174
DEFAULT_CLUSTER=devnet

# Twitter OAuth 2.0 (PKCE)
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=
TWITTER_CALLBACK_URL=http://localhost:3090/v1/auth/twitter/callback
FRONTEND_URL=http://localhost:3000

# Optional — indexer ingest (only if onevault-indexer is running on :3001)
ADMIN_INGEST_KEY=
INDEXER_INGEST_URL=http://127.0.0.1:3001/api/ingest
# Server-side keeper for auto-sign steps (update_nav, keeper_refresh)
KEEPER_KEYPAIR=
DEVNET_RPC_URL=
MAINNET_RPC_URL=

# PROGRAM_IDS priority order (1 = default execute_trade):
#   1. Pump.fun Bonding Curve  6EF8rrecthR5Dkzon8Nwu78hRvfCKubJ14M5uBEwF6P
#   2. Pump.fun AMM            pAMMBay6oceH9fJKBRHGP5D4bD4sWpmSwMn52FMfXEA
#   3. Pump.fun Fee            pfeeUxB6jkeY1Hxd7CsFCAjcbHA9rWtchMGdZ6VojVZ
#   4. Meteora DBC             dbcij3LWUppWqq96dh6gJWwBifmcGfLSB5D4DuSMaqN
#   5. Raydium AMM v4          675kPX9MHTjS2zt1qfr1iGq9WZ3YdExgkt1PyfuzMdud
#   6. Meteora DLMM            LBUZKhRxPF3XUpBCj4kGkTq6v4D4ew3Efr2E1V9LG8K
# PROGRAM_IDS=6EF8rrecthR5Dkzon8Nwu78hRvfCKubJ14M5uBEwF6P,pAMMBay6oceH9fJKBRHGP5D4bD4sWpmSwMn52FMfXEA,pfeeUxB6jkeY1Hxd7CsFCAjcbHA9rWtchMGdZ6VojVZ,dbcij3LWUppWqq96dh6gJWwBifmcGfLSB5D4DuSMaqN,675kPX9MHTjS2zt1qfr1iGq9WZ3YdExgkt1PyfuzMdud,LBUZKhRxPF3XUpBCj4kGkTq6v4D4ew3Efr2E1V9LG8K
# Optional override of the default execute_trade program
# ALLOWED_DEX_PROGRAM=

# Market data (token price / kline / research / wallets / auto proceeds)
# GMGN_API_KEY=
# GMGN_BASE_URL=
# Required only for wallet holdings (signed requests):
# GMGN_PRIVATE_KEY=
# GMGN_PRIVATE_KEY_PASSPHRASE=

# Optional market discovery overrides (defaults work without keys)
# DEX_BASE_URL=https://api.dexscreener.com
# DEX_WS_URL=wss://api.dexscreener.com

# Mainnet address overrides (placeholders until deploy)
# MAINNET_PROGRAM_ID=
# MAINNET_PROTOCOL_CONFIG=
# MAINNET_PLATFORM_WALLET=
# MAINNET_DEGEN_FEE_WALLET=
# MAINNET_LICENSE_MINT=

