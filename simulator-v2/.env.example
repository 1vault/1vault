# 1Vault backend API (Go)
# Local: Vite proxies /v1 → this URL (dev server only).
# Railway: set as *build* variable to the public backend URL, e.g.
#   VITE_BACKEND_URL=https://your-backend.up.railway.app
# Also add the simulator origin to backend CORS_ORIGINS.
VITE_BACKEND_URL=http://127.0.0.1:3090
VITE_CLUSTER=devnet
VITE_PORT=5174

# Public RPC for wallet balance preview + demo mint (prefer Helius on devnet)
VITE_SOLANA_RPC=https://api.devnet.solana.com

# X (Twitter) login uses backend OAuth — set on backend/.env:
#   TWITTER_CLIENT_ID, TWITTER_CLIENT_SECRET
#   TWITTER_CALLBACK_URL=http://localhost:3090/v1/auth/twitter/callback
#   CORS_ORIGINS must include http://localhost:5174 (and Railway simulator URL)

# Optional: reuse an existing mint for open-position. If unset, simulator-v2
# auto-creates a DEMO mint (same as original simulator).
# VITE_DEMO_OUTPUT_MINT=
